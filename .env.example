# Environment variables for SPORTLINK
GEMINI_API_KEY=

# PostgreSQL Database Configuration (no secrets committed)
PGHOST=localhost
PGPORT=5432
PGDATABASE=sportlink
PGUSER=sportlink_app
PGPASSWORD=
PGSSL=false
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=5000

# Application Timezone
APP_TIMEZONE=Asia/Tehran
